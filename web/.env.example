# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase → Project Settings → API). Ne jamais committer .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clé secrète (service_role) : uniquement côté serveur, pour créer les comptes.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
